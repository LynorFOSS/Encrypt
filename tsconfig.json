{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@encrypt/ui": ["packages/ui/src/index.ts"],
      "@encrypt/shared": ["packages/shared/src/index.ts"],
      "@encrypt/config/*": ["packages/config/*"]
    },
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "apps/**/*",
    "tests/**/*",
    "scripts/**/*"
  ]
}