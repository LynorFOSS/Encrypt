import("//build/config/chromeos/ui_mode.gni")
import("//build/config/sanitizers/sanitizers.gni")
import("//build/config/sysroot.gni")

# IMPORTANT
# We are not accepting any new build flags in //chrome. See
# docs/chrome_browser_design_principles.md.

declare_args() {
  enable_linux_installer =
      is_linux && !is_component_build && use_sysroot && !using_sanitizer

  # Enable AppImage generation for Linux
  enable_appimage_generator = is_linux && !is_component_build && use_sysroot && !using_sanitizer

  # Enable Windows MSI installer generation
  enable_msi_installer = is_win

  # Enable Windows mini_installer (.exe) generation
  enable_mini_installer = is_win

  # Controls the number of threads used to run xz while producing a Debian package.
  linux_debian_pkg_xz_nthreads = 0
}

enable_mac_installer = is_mac && !is_chrome_for_testing
enable_mac_app_bundle = is_mac
